            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Analista Inventario\",\n  \"email\": \"analista@inventario.com\",\n  \"password\": \"123456\",\n  \"role\": \"operator\",\n  \"active\": true\n}"
